# Generate required credentials with: python3 scripts/init-env.py
# Preserve existing values when reusing a database volume.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
POSTGRES_PASSWORD=

# Optional upstream credential for the README model example.
PROVIDER_API_KEY=

